# Copia este archivo como .streamlit/secrets.toml en local, o pega su contenido
# (con tus valores reales) en Streamlit Cloud -> Settings -> Secrets.
# NUNCA subas secrets.toml con valores reales a este repositorio.

# --- Base de datos (repo privado GIUSEPPESAN21/UNIMINUTO-Lab-Database) ---
# Genera un Personal Access Token de tipo "Fine-grained", con acceso SOLO
# a este repositorio y permiso "Contents: Read and write".
GITHUB_TOKEN = "pega-aqui-tu-token-nuevo"
GITHUB_REPO = "GIUSEPPESAN21/UNIMINUTO-Lab-Database"
GITHUB_DB_PATH = "UNIMINUTO_LAB_DB.xlsx"

# --- Cuenta maestra inicial (se crea automaticamente al primer arranque) ---
MASTER_EMAIL = "admin@uniminuto.edu.co"
MASTER_INITIAL_PASSWORD = "cambia-esta-clave-apenas-inicies-sesion"

# El registro acepta cualquier correo institucional (dominio terminado en
# .edu o .edu.co); no requiere configuracion adicional.

# --- Alertas por WhatsApp (opcional, Twilio) ---
# TWILIO_ACCOUNT_SID = ""
# TWILIO_AUTH_TOKEN = ""
# TWILIO_WHATSAPP_FROM_NUMBER = ""
# DESTINATION_WHATSAPP_NUMBER = ""
# --- Correo automático para solicitudes y reservas (opcional) ---
# Si ADMIN_NOTIFICATION_EMAILS queda vacío, la app usa los correos de los
# usuarios activos con rol profesor o maestro.
ADMIN_NOTIFICATION_EMAILS = ["administrador@uniminuto.edu.co"]
SMTP_HOST = "smtp.office365.com"
SMTP_PORT = 587
SMTP_USERNAME = "notificaciones@uniminuto.edu.co"
SMTP_PASSWORD = "configura-esta-clave-solo-en-streamlit-secrets"
SMTP_FROM_EMAIL = "notificaciones@uniminuto.edu.co"
SMTP_USE_TLS = true
SMTP_USE_SSL = false
# Opcional: enlace a la app dentro de cada correo.
# APP_URL = "https://tu-app.streamlit.app"

# --- Seguridad (opcional; se muestran los valores por defecto) ---
# LOGIN_MAX_ATTEMPTS = 5          # intentos fallidos antes de bloquear un correo
# LOGIN_LOCKOUT_MINUTES = 5       # duracion del bloqueo
# SESSION_TIMEOUT_MINUTES = 720   # la sesion expira a las 12 horas
